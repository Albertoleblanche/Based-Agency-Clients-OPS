{
  "crons": [
    {
      "path": "/api/cron-wednesday-notify",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron-google-calendar-sync",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/integrations?route=calendar-tick&run=12",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/integrations?route=calendar-tick&run=16",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/integrations?route=calendar-tick&run=20",
      "schedule": "0 20 * * *"
    }
  ],
  "functions": {
    "api/cron-wednesday-notify.js": {
      "maxDuration": 60
    },
    "api/cron-google-calendar-sync.js": {
      "maxDuration": 60
    },
    "api/integrations.js": {
      "maxDuration": 60
    },
    "api/send-slack-message.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/integrations?route=mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/integrations?route=oauth-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/integrations?route=oauth-resource"
    },
    {
      "source": "/slack/oauth",
      "destination": "/api/integrations?route=slack-me-callback"
    },
    {
      "source": "/hooks/granola",
      "destination": "/api/send-slack-message?source=granola"
    },
    {
      "source": "/oauth/consent",
      "destination": "/oauth-consent.html"
    }
  ]
}
