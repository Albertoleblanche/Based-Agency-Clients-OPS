# Copy to .env (never commit .env). Get the values from Supabase / Anthropic / Slack.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
SLACK_BOT_TOKEN=xoxb-

# Optional
CLAUDE_MODEL=claude-sonnet-5-5
TZ=America/New_York
# Times the digest runs every day (24h, comma separated, in TZ above)
DIGEST_TIMES=09:00,15:00
# Groups are read only if the name matches this pattern...
GROUP_NAME_PATTERN=marketing
# ...or is listed here (comma separated, exact name, case-insensitive)
GROUP_ALLOWLIST=American Mutual Insurance | Based Agency
# Names that count as "our side" in a group (comma separated, matched against the sender's display name)
TEAM_SENDER_HINTS=Based Agency,Albert,Stan,Eric,Charlie,Dan,Daniel,Joey
# Who gets the full view
ADMIN_KEYS=eric,dan
# Link shown in Slack messages
RADAR_URL=https://YOUR-RADAR-URL/#whatsapp
# How many days of messages the agent looks at for context
CONTEXT_DAYS=7

# Live watch (Nov 24): the quick read of each new burst of client messages
# WATCH_MODEL=claude-haiku-5-5
# Work hours, for counting how long a client has waited (weekdays, team time zone)
# WORK_HOURS=9-18
# Work minutes a client waits for a reply before their owner is nudged
# WAIT_NUDGE_MINUTES=120
